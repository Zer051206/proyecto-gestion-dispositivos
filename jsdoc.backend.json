{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["server/src"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "destination": "./docs/backend/",
    "recurse": true,
    "readme": "./README.md"
  }
}
