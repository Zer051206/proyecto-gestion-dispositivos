{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["client/src"],
    "includePattern": ".+\\.(js|jsx)$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "destination": "./docs/frontend/",
    "recurse": true,
    "readme": "./README.md"
  }
}
